#
# Originaly a fastbike profile
# Modified for road racing
#

---context:global   # following code refers to global config

# Bike profile
assign validForBikes = true

# Use the following switches to change behaviour
assign allow_steps           = true   # %allow_steps% | Povolit schody | boolean

# Change elevation parameters
assign downhillcost       = 0    # %downhillcost% | Cena za jízdu z kopce | number
assign downhillcutoff     = 8   # %downhillcutoff% | Nižší sklon než tento se do jízdy z kopce nezapočítá. | number
assign uphillcost         = 10     # %uphillcost% | Cena za jízdu do kopce | number
assign uphillcutoff       = 0   # %uphillcutoff% | Nižší sklon než tento se do jízdy do kopce nezapočítá.  | number

assign primaryCost         = 0     # %primaryCost% | Cena za jízdu po silnici první třídy | number
assign unpavedFactor       = 1    # %unpavedFactor% | Ovlivní routování přes nezpevněné cesty, 0.5 znamená o 50% nižší náklady oproti defaultu | number

include base/global.speed.brf CR_SPEED=0.01

# Turn instructions settings
assign turnInstructionMode          = 1
assign turnInstructionCatchingRange = 40
assign turnInstructionRoundabouts   = true
assign considerTurnRestrictions     = true

assign processUnusedTags            = true

---context:way   # following code refers to way-tags

include base/way.surface.brf
include base/way.surface.road.brf
include base/way.initialcost.brf
include base/way.accesspenalty.brf
include base/way.oneway.brf

assign isreversed = reversedirection=yes

include base/way.town.brf TOWN_FACTOR=1

assign wayPenaltyCost
    switch    route=ferry                                                                          10000 # not passable
    switch    highway=motorway|motorway_link|trunk|trunk_link|construction|proposed|abandoned      10000 # not passable
    switch    highway=steps                                                                        switch allow_steps 10 10000
    switch    highway=primary|primary_link                                                         primaryCost
    switch    highway=secondary|secondary_link|tertiary|tertiary_link|cycleway|rest_area|pedestrian|residential|living_street|service|residential|unclassified|bridleway|track|road|path|footway                                   0
    10000 # I can't ride on not roads

# on these road I wont be able to ride fast
assign trafficPenaltyCost
  switch highway=pedestrian|footway     0.2
  switch highway=living_street          0.1
  0

assign costfactor
  add onewaypenalty
  add accesspenalty
  add town_penalty
  add surfaceCost
  add trafficPenaltyCost
  add wayPenaltyCost
  0

# faster road, bigger turn cost
assign turncost = if junction=roundabout then 0 else divide 100 costfactor

---context:node  # following code refers to node tags

include base/node.brf traffic_lights_avoideness=200
