assign surfaceCost
    switch or surface=asphalt|concrete equal surface surface_asphalt
        switch or smoothness=excellent equal smoothness smoothness_excellent           multiply 1.5 pavedFactor
        switch or smoothness=good equal smoothness smoothness_good                     multiply 1.5 pavedFactor
        switch or smoothness=intermediate equal smoothness smoothness_intermediate     multiply 1.5 pavedFactor
        switch or smoothness=bad equal smoothness smoothness_bad                       multiply 1.5 pavedFactor
        switch or smoothness=very_bad equal smoothness smoothness_very_bad             multiply 2 pavedFactor
        switch or smoothness=horrible equal smoothness smoothness_horrible             multiply 3 pavedFactor
        switch or smoothness=very_horrible equal smoothness smoothness_very_horrible   multiply 4 pavedFactor
                                                                                      10
    switch surface=paving_stones|wood|metal|paved
        switch or smoothness=excellent equal smoothness smoothness_excellent           multiply 1.5 pavedFactor
        switch or smoothness=good equal smoothness smoothness_good                     multiply 1.5 pavedFactor
        switch or smoothness=intermediate equal smoothness smoothness_intermediate     multiply 1.5 pavedFactor
        switch or smoothness=bad equal smoothness smoothness_bad                       multiply 1.5 pavedFactor
        switch or smoothness=very_bad equal smoothness smoothness_very_bad             multiply 2 pavedFactor
        switch or smoothness=horrible equal smoothness smoothness_horrible             multiply 3 pavedFactor
        switch or smoothness=very_horrible equal smoothness smoothness_very_horrible   multiply 4 pavedFactor
                                                                                      10
    switch surface=sett|grass_paver|cobblestone
        switch or smoothness=excellent equal smoothness smoothness_excellent           multiply 1.5 pavedFactor
        switch or smoothness=good equal smoothness smoothness_good                     multiply 1.5 pavedFactor
        switch or smoothness=intermediate equal smoothness smoothness_intermediate     multiply 1.5 pavedFactor
        switch or smoothness=bad equal smoothness smoothness_bad                       multiply 2.0 pavedFactor
        switch or smoothness=very_bad equal smoothness smoothness_very_bad             multiply 3.5 pavedFactor
        switch or smoothness=horrible equal smoothness smoothness_horrible             multiply 4.5 pavedFactor
        switch or smoothness=very_horrible equal smoothness smoothness_very_horrible   multiply 5.5 pavedFactor
                                                                                      10
    switch or surface=compacted|fine_gravel equal surface surface_fine_gravel
        switch or smoothness=excellent equal smoothness smoothness_excellent             1
        switch or smoothness=good equal smoothness smoothness_good                       1
        switch or smoothness=intermediate equal smoothness smoothness_intermediate       1.2
        switch or smoothness=bad equal smoothness smoothness_bad                         1.5
        switch or smoothness=very_bad equal smoothness smoothness_very_bad               2
        switch or smoothness=horrible equal smoothness smoothness_horrible               4
        switch or smoothness=very_horrible equal smoothness smoothness_very_horrible     5
                                                                                        10

    switch or surface=gravel|pebblestone|unpaved equal surface surface_gravel
        switch or smoothness=excellent equal smoothness smoothness_excellent             1.2
        switch or smoothness=good equal smoothness smoothness_good                       1.4
        switch or smoothness=intermediate equal smoothness smoothness_intermediate       1.6
        switch or smoothness=bad equal smoothness smoothness_bad                         2
        switch or smoothness=very_bad equal smoothness smoothness_very_bad               4
        switch or smoothness=horrible equal smoothness smoothness_horrible               5
        switch or smoothness=very_horrible equal smoothness smoothness_very_horrible    10
                                                                                        10

    switch or surface=ground|dirt|earth|grass|mud|sand equal surface surface_unpaved
        switch or smoothness=excellent equal smoothness smoothness_excellent             1.3
        switch or smoothness=good equal smoothness smoothness_good                       1.6
        switch or smoothness=intermediate equal smoothness smoothness_intermediate       2
        switch or smoothness=bad equal smoothness smoothness_bad                         4
        switch or smoothness=very_bad equal smoothness smoothness_very_bad               5
        switch or smoothness=horrible equal smoothness smoothness_horrible              10
        switch or smoothness=very_horrible equal smoothness smoothness_very_horrible    10
                                                                                        10
    0
