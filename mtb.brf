#
# It tries to find a long distance MTB route
# It preferes MTB trails, paved climbs and unpaved downhills

---context:global   # following code refers to global config

# Bike profile
assign validForBikes = true

# Change elevation parameters
assign downhillcost       = 0    # %downhillcost% | Cena za jízdu z kopce | number
assign downhillcutoff     = 8   # %downhillcutoff% | Nižší sklon než tento se do jízdy z kopce nezapočítá. | number
assign uphillcost         = 0     # %uphillcost% | Cena za jízdu do kopce | number
assign uphillcutoff       = 5   # %uphillcutoff% | Nižší sklon než tento se do jízdy do kopce nezapočítá.  | number

# Kinematic model parameters (travel time computation)
assign totalMass  = 86     # %totalMass% | Celková váha (kolo, výbava + jezdec), pouze pro výpočet času jízdy | number
assign maxSpeed   = 60
assign S_C_x      = 0.225  # %S_C_x% | Odpor vzduchu, pouze pro výpočet času jízdy | number
assign C_r        = 0.03   # %C_r% | Odpor plášťů, pouze pro výpočet času jízdy | number
assign bikerPower = 180    # %bikerPower% | Průměrný výkon ve W, pouze pro výpočet času jízdy | number


# Turn instructions settings
assign turnInstructionMode          = 1
assign turnInstructionCatchingRange = 40
assign turnInstructionRoundabouts   = true
assign considerTurnRestrictions     = true

assign processUnusedTags            = true

---context:way   # following code refers to way-tags

assign smoothness_excellent           = 1
assign smoothness_good                = 2
assign smoothness_intermediate        = 3
assign smoothness_bad                 = 4
assign smoothness_very_bad            = 5
assign smoothness_horrible            = 6
assign smoothness_very_horrible       = 7
assign smoothness_impassable          = 8

assign smoothness
    switch smoothness=very_good                                                                   smoothness_good
    switch smoothness=excellent                                                                   smoothness_excellent
    switch smoothness=good                                                                        smoothness_good
    switch smoothness=intermediate                                                                smoothness_intermediate
    switch smoothness=bad                                                                         smoothness_bad
    switch smoothness=very_bad                                                                    smoothness_very_bad
    switch smoothness=horrible                                                                    smoothness_horrible
    switch smoothness=very_horrible                                                               smoothness_very_horrible
    switch smoothness=impassable                                                                  smoothness_impassable
    # defaults smoothness if smoothness tag is not set, based on tracktype and highway
    switch tracktype=grade1                                                                       smoothness_good
    switch tracktype=grade2                                                                       smoothness_intermediate
    switch tracktype=grade3                                                                       smoothness_bad
    switch tracktype=grade4|grade5                                                                smoothness_very_bad
    switch highway=primary|primary_link|raceway|corridor                                          smoothness_excellent
    switch highway=secondary|secondary_link|cycleway|rest_area|living_street|residential|steps|platform|crossing  smoothness_good
    switch highway=tertiary|tertiary_link|service|track|unclassified|footway                      smoothness_intermediate
    switch highway=bridleway|road|path                                                            smoothness_bad
                                                                                                  smoothness_impassable

assign surface_asphalt             = 1
assign surface_paved               = 2
assign surface_fine_gravel         = 3
assign surface_gravel              = 4
assign surface_unpaved             = 5
assign surface_sett                = 6

assign surface
    switch surface=asphalt|concrete                 surface_asphalt
    switch surface=paving_stones|wood|metal|paved   surface_paved
    switch surface=sett|grass_paver|cobblestone     surface_sett
    switch surface=compacted|fine_gravel            surface_fine_gravel
    switch surface=gravel|pebblestone|unpaved       surface_gravel
    switch surface=ground|dirt|earth|grass|mud|sand surface_unpaved
    # defaults surface if surface tag is not set, based on tracktype and highway
    switch tracktype=grade1                     surface_asphalt
    switch tracktype=grade2                     surface_fine_gravel
    switch tracktype=grade3                     surface_gravel
    switch tracktype=grade4|grade5              surface_unpaved
    switch highway=primary|primary_link|secondary|secondary_link|tertiary|tertiary_link|cycleway|rest_area|pedestrian|residential|living_street|service|residential|unclassified|steps|platform         surface_asphalt
                                                surface_unpaved

assign isPaved or surface=paved|asphalt|concrete|paving_stones|grass_paver|sett|cobblestone|metal|wood equal surface surface_asphalt
assign isUnpaved not isPaved

assign roadDifficulty
    switch isPaved                                                                      0
    switch sac_scale=demanding_mountain_hiking                                          5
    switch incline=25%                                                                  5
    switch mtb:scale=1                                                                  2
    switch equal surface surface_fine_gravel
        switch or smoothness=excellent equal smoothness smoothness_excellent            1
        switch or smoothness=good equal smoothness smoothness_good                      2
        switch or smoothness=intermediate equal smoothness smoothness_intermediate      2
        switch or smoothness=bad equal smoothness smoothness_bad                        3
        switch or smoothness=very_bad equal smoothness smoothness_very_bad              4
        switch or smoothness=horrible equal smoothness smoothness_horrible              5
        switch or smoothness=very_horrible equal smoothness smoothness_very_horrible    5
                                                                                        5

    switch equal surface surface_gravel
        switch or smoothness=excellent equal smoothness smoothness_excellent            1
        switch or smoothness=good equal smoothness smoothness_good                      2
        switch or smoothness=intermediate equal smoothness smoothness_intermediate      3
        switch or smoothness=bad equal smoothness smoothness_bad                        4
        switch or smoothness=very_bad equal smoothness smoothness_very_bad              5
        switch or smoothness=horrible equal smoothness smoothness_horrible              5
        switch or smoothness=very_horrible equal smoothness smoothness_very_horrible    5
                                                                                        5

    switch equal surface surface_unpaved
        switch or smoothness=excellent equal smoothness smoothness_excellent           1
        switch or smoothness=good equal smoothness smoothness_good                     2
        switch or smoothness=intermediate equal smoothness smoothness_intermediate     3
        switch or smoothness=bad equal smoothness smoothness_bad                       4
        switch or smoothness=very_bad equal smoothness smoothness_very_bad             5
        switch or smoothness=horrible equal smoothness smoothness_horrible             5
        switch or smoothness=very_horrible equal smoothness smoothness_very_horrible   5
                                                                                       5
    0

# classifier constants
assign classifier_none           = 1
assign classifier_ferry          = 2
assign classifier_crossing       = 3

assign initialclassifier =
    if route=ferry then classifier_ferry
    else if footway=crossing then classifier_crossing
    else classifier_none

# do not use ferries
assign initialcost =
    if equal initialclassifier classifier_ferry then 10000
    else if and equal initialclassifier classifier_crossing crossing=traffic_signals then 300
    else if equal initialclassifier classifier_crossing then 100
    else 0

assign accesspenalty
    switch motorroad=yes 10000 # I can't access motorroads
    switch highway=motorway|motorway_link|trunk|trunk_link|construction|proposed|abandoned 10000 # I can't access highways
    switch or access=private|no bicycle=private 10000 # I can't access private roads
    switch or bicycle=no ( and highway=footway and footway=sidewalk not bicycle=yes|designated ) 5 # I shoudn't ride on sidewalks
    0

assign badoneway =
       if reversedirection=yes then
         if oneway:bicycle=yes then true
         else if oneway= then junction=roundabout
         else oneway=yes|true|1
       else oneway=-1

assign onewaypenalty =
       if ( badoneway ) then
       (
         if      ( cycleway=opposite|opposite_lane|opposite_track       ) then 0
         else if ( cycleway:left=opposite|opposite_lane|opposite_track  ) then 0
         else if ( cycleway:right=opposite|opposite_lane|opposite_track ) then 0
         else if ( oneway:bicycle=no                         ) then 0
         else if ( cycleway:left:oneway=no                   ) then 0
         else if ( cycleway:right:oneway=no                  ) then 0
         else if ( junction=roundabout|circular              ) then 60
         else if ( highway=primary|primary_link|secondary|secondary_link              ) then 50
         else if ( highway=tertiary|tertiary_link            ) then 20
         else 6
       )
       else 0

assign isreversed = reversedirection=yes


assign isreversed = reversedirection=yes

assign town_penalty_factor 1

assign town_penalty
   switch estimated_town_class=   multiply 0 town_penalty_factor
   switch estimated_town_class=1  multiply 0.2 town_penalty_factor
   switch estimated_town_class=2  multiply 0.6 town_penalty_factor
   switch estimated_town_class=3  multiply 0.8 town_penalty_factor
   switch estimated_town_class=4  multiply 1 town_penalty_factor
   switch estimated_town_class=5  multiply 1.2 town_penalty_factor
   switch estimated_town_class=6  multiply 2 town_penalty_factor
   99


assign any_hiking_route or route=hiking         or route_hiking_iwn=yes
						or route_hiking_nwn=yes	or route_hiking_rwn=yes
						or route_hiking_lwn=yes or route_hiking_=yes
                        or route_foot_=yes      or route_foot_nwn=yes
						or route_foot_rwn=yes      route_foot_lwn=yes

assign any_cycleroute  or route_bicycle_icn=yes or route_bicycle_ncn=yes or route_bicycle_rcn=yes or route_bicycle_lcn=yes route=bicycle

assign mtb_route
     switch route_mtb_=yes  true
     switch route_mtb_lcn=yes true
     switch route_mtb_ncn=yes true
     switch route_mtb_rcn=yes true
     switch route_mtb_mtb=yes true
     switch route_bicycle_mtb=yes true
     switch and highway=path bicycle=designated true
     false

assign markedPaths
    switch    mtb_route 0
    switch    or any_cycleroute any_hiking_route 1
    2

assign markedPathsUphill
    switch    or any_cycleroute mtb_route 0
    2

assign bigRoadPenalty
     switch highway=primary|primary_link       2
     switch highway=secondary|secondary_link  0.6
     0

assign baseCost
  add onewaypenalty
  add accesspenalty
  add town_penalty
  add bigRoadPenalty
  0

assign surfacePenaltyFlat
    switch    equal roadDifficulty    0 1.5
    switch    equal roadDifficulty    1 0.2
    switch    equal roadDifficulty    2 0
    switch    equal roadDifficulty    3 0
    switch    equal roadDifficulty    4 0.5
    switch    equal roadDifficulty    5 1
    0

assign surfacePenaltyUphill
    switch    equal roadDifficulty    0 1
    switch    equal roadDifficulty    1 0
    switch    equal roadDifficulty    2 0
    switch    equal roadDifficulty    3 5
    switch    equal roadDifficulty    4 8
    switch    equal roadDifficulty    5 10
    0

assign surfacePenaltyDownhill
    switch    equal roadDifficulty    0 2
    switch    equal roadDifficulty    1 1
    switch    equal roadDifficulty    2 0.5
    switch    equal roadDifficulty    3 0
    switch    equal roadDifficulty    4 0
    switch    equal roadDifficulty    5 0.3
    0

assign costfactor
  add baseCost
  add surfacePenaltyFlat
  add markedPaths
  2

assign downhillcostfactor
    add baseCost
    add surfacePenaltyDownhill
    add markedPaths
    0

assign uphillcostfactor
    add baseCost
    add surfacePenaltyUphill
    add markedPathsUphill
    0

assign turncost 0

---context:node

assign applyDirection =
    switch and direction=backward way:isreversed 1
    switch and direction=backward not way:isreversed 0
    switch and direction=forward not way:isreversed 1
    switch and direction=forward way:isreversed 0
    0

assign applyTrafficDirection
    switch and traffic_signals:direction=backward way:isreversed 1
    switch and traffic_signals:direction=backward not way:isreversed 0
    switch and traffic_signals:direction=forward not way:isreversed 1
    switch and traffic_signals:direction=forward way:isreversed 0
    0

assign barrierPenalty
	switch barrier=block|bollard 25
	switch barrier=gate|swing_gate|lift_gate|entrance 50
	switch barrier=cycle_barrier 90
	switch and traffic_calming=bump applyDirection 25
	switch and traffic_calming=cushion applyDirection 10
		0

assign crossingsPenalty
	switch or railway=level_crossing railway=crossing 300
	switch and highway=traffic_signals applyTrafficDirection 200
	switch and highway=crossing not crossing=unmarked 25
	switch and highway=give_way applyDirection 80
	switch and highway=stop applyDirection 120
		0

assign initialcost =
	add barrierPenalty
	add crossingsPenalty
    0

