#
# Originaly a fastbike profile
# Modified for road traveling - it prefers cycling infrastructure, roads without cars and cycling routes, but it is not a must.
#

---context:global   # following code refers to global config

# Bike profile
assign validForBikes = true

# Change elevation parameters
assign downhillcost       = 0     # %downhillcost% | Cena za jízdu z kopce | number
assign downhillcutoff     = 0     # %downhillcutoff% | Nižší sklon než tento se do jízdy z kopce nezapočítá. | number
assign uphillcost         = 10    # %uphillcost% | Cena za jízdu do kopce | number
assign uphillcutoff       = 5     # %uphillcutoff% | Nižší sklon než tento se do jízdy do kopce nezapočítá.  | number

assign primaryCost         = 1    # %primaryCost% | Cena za jízdu po silnici první třídy | number
assign unpavedFactor       = 2.5    # %unpavedFactor% | Ovlivní routování přes nezpevněné cesty, 0.5 znamená o 50% nižší náklady oproti defaultu | number
assign forestFactor         = 0.5    # %forestFactor% | Ovlivní routování přes lesy, 0.5 znamená o 50% nižší náklady mimo les oproti defaultu. 0 faktor lesů vypne | number
assign cyclingInfrastuctureFactor         = 0.7    # %cyclingInfrastuctureFactor% | Ovlivní routování přes cyklistickou infrastrukturu a trasy. 0.5 znamená o 50% nižší náklady trasám bez infrastruktury oproti defaultu. 0 faktor infrastruktury vypne a bude se soutředit na kvalitu cest | number

# Kinematic model parameters (travel time computation)
assign totalMass  = 86     # %totalMass% | Celková váha (kolo, výbava + jezdec), pouze pro výpočet času jízdy | number
assign maxSpeed   = 60
assign S_C_x      = 0.225  # %S_C_x% | Odpor vzduchu, pouze pro výpočet času jízdy | number
assign C_r        = 0.01   # %C_r% | Odpor plášťů, pouze pro výpočet času jízdy | number
assign bikerPower = 180    # %bikerPower% | Průměrný výkon ve W, pouze pro výpočet času jízdy | number


# Turn instructions settings
assign turnInstructionMode          = 1
assign turnInstructionCatchingRange = 40
assign turnInstructionRoundabouts   = true
assign considerTurnRestrictions     = true

assign processUnusedTags            = true

---context:way   # following code refers to way-tags

assign smoothness_excellent           = 1
assign smoothness_good                = 2
assign smoothness_intermediate        = 3
assign smoothness_bad                 = 4
assign smoothness_very_bad            = 5
assign smoothness_horrible            = 6
assign smoothness_very_horrible       = 7
assign smoothness_impassable          = 8

assign smoothness
    switch smoothness=very_good                                                                   smoothness_good
    switch and not smoothness= not smoothness=unknown                                             smoothness
    # defaults smoothness if smoothness tag is not set, based on tracktype and highway
    switch tracktype=grade1                                                                       smoothness_good
    switch tracktype=grade2                                                                       smoothness_intermediate
    switch tracktype=grade3                                                                       smoothness_bad
    switch tracktype=grade4|grade5                                                                smoothness_very_bad
    switch highway=primary|primary_link|raceway|corridor                                          smoothness_excellent
    switch highway=secondary|secondary_link|cycleway|rest_area|living_street|residential|steps|platform|crossing  smoothness_good
    switch highway=tertiary|tertiary_link|service|track|unclassified|footway                      smoothness_intermediate
    switch highway=bridleway|road|path                                                            smoothness_bad
                                                                                                  smoothness_impassable

assign surface_asphalt             = 1
assign surface_fine_gravel         = 2
assign surface_gravel              = 3
assign surface_unpaved             = 4

assign surface
    switch and not surface= not surface=unknown surface
    # defaults surface if surface tag is not set, based on tracktype and highway
    switch tracktype=grade1                     surface_asphalt
    switch tracktype=grade2                     surface_fine_gravel
    switch tracktype=grade3                     surface_gravel
    switch tracktype=grade4|grade5              surface_unpaved
    switch highway=primary|primary_link|secondary|secondary_link|tertiary|tertiary_link|cycleway|rest_area|pedestrian|residential|living_street|service|residential|unclassified|steps|platform         surface_asphalt
                                                surface_unpaved

assign isPaved or surface=paved|asphalt|concrete|paving_stones|grass_paver|sett|cobblestone|metal|wood equal surface surface_asphalt
assign isUnpaved not isPaved

assign surfaceCost
    switch or surface=asphalt|concrete equal surface surface_asphalt
        switch or smoothness=excellent equal smoothness smoothness_excellent           1.00
        switch or smoothness=good equal smoothness smoothness_good                     1.05
        switch or smoothness=intermediate equal smoothness smoothness_intermediate     1.2
        switch or smoothness=bad equal smoothness smoothness_bad                       1.5
        switch or smoothness=very_bad equal smoothness smoothness_very_bad             2
        switch or smoothness=horrible equal smoothness smoothness_horrible             3
        switch or smoothness=very_horrible equal smoothness smoothness_very_horrible   4
                                                                                      10
    switch surface=paving_stones|wood|metal|paved
        switch or smoothness=excellent equal smoothness smoothness_excellent           1.1
        switch or smoothness=good equal smoothness smoothness_good                     1.15
        switch or smoothness=intermediate equal smoothness smoothness_intermediate     1.3
        switch or smoothness=bad equal smoothness smoothness_bad                       1.5
        switch or smoothness=very_bad equal smoothness smoothness_very_bad             2
        switch or smoothness=horrible equal smoothness smoothness_horrible             3
        switch or smoothness=very_horrible equal smoothness smoothness_very_horrible   4
                                                                                      10
    switch surface=sett|grass_paver|cobblestone
        switch or smoothness=excellent equal smoothness smoothness_excellent           1.2
        switch or smoothness=good equal smoothness smoothness_good                     1.25
        switch or smoothness=intermediate equal smoothness smoothness_intermediate     1.5
        switch or smoothness=bad equal smoothness smoothness_bad                       2.0
        switch or smoothness=very_bad equal smoothness smoothness_very_bad             3.5
        switch or smoothness=horrible equal smoothness smoothness_horrible             4.5
        switch or smoothness=very_horrible equal smoothness smoothness_very_horrible   5.5
                                                                                      10
    switch or surface=compacted|fine_gravel equal surface surface_fine_gravel
        switch or smoothness=excellent equal smoothness smoothness_excellent            multiply unpavedFactor 1.5
        switch or smoothness=good equal smoothness smoothness_good                      multiply unpavedFactor 1.8
        switch or smoothness=intermediate equal smoothness smoothness_intermediate      multiply unpavedFactor 2.5
        switch or smoothness=bad equal smoothness smoothness_bad                        multiply unpavedFactor 4
        switch or smoothness=very_bad equal smoothness smoothness_very_bad             multiply unpavedFactor 10
        switch or smoothness=horrible equal smoothness smoothness_horrible             multiply unpavedFactor 10
        switch or smoothness=very_horrible equal smoothness smoothness_very_horrible   multiply unpavedFactor 10
                                                                                       multiply unpavedFactor 10

    switch or surface=gravel|pebblestone|unpaved equal surface surface_gravel
        switch or smoothness=excellent equal smoothness smoothness_excellent            multiply unpavedFactor 1.8
        switch or smoothness=good equal smoothness smoothness_good                      multiply unpavedFactor 2.8
        switch or smoothness=intermediate equal smoothness smoothness_intermediate      multiply unpavedFactor 3.8
        switch or smoothness=bad equal smoothness smoothness_bad                       multiply unpavedFactor 10
        switch or smoothness=very_bad equal smoothness smoothness_very_bad             multiply unpavedFactor 10
        switch or smoothness=horrible equal smoothness smoothness_horrible             multiply unpavedFactor 10
        switch or smoothness=very_horrible equal smoothness smoothness_very_horrible   multiply unpavedFactor 10
                                                                                       multiply unpavedFactor 10

    switch or surface=ground|dirt|earth|grass|mud|sand equal surface surface_unpaved
        switch or smoothness=excellent equal smoothness smoothness_excellent           multiply unpavedFactor  2
        switch or smoothness=good equal smoothness smoothness_good                     multiply unpavedFactor  5
        switch or smoothness=intermediate equal smoothness smoothness_intermediate     multiply unpavedFactor 10
        switch or smoothness=bad equal smoothness smoothness_bad                       multiply unpavedFactor 10
        switch or smoothness=very_bad equal smoothness smoothness_very_bad             multiply unpavedFactor 10
        switch or smoothness=horrible equal smoothness smoothness_horrible             multiply unpavedFactor 10
        switch or smoothness=very_horrible equal smoothness smoothness_very_horrible   multiply unpavedFactor 10
                                                                                       multiply unpavedFactor 10
    0

# classifier constants
assign classifier_none           = 1
assign classifier_ferry          = 2
assign classifier_crossing       = 3

assign initialclassifier =
    if route=ferry then classifier_ferry
    else if footway=crossing then classifier_crossing
    else classifier_none

# do not use ferries
assign initialcost =
    if equal initialclassifier classifier_ferry then 10000
    else if and equal initialclassifier classifier_crossing crossing=traffic_signals then 300
    else if equal initialclassifier classifier_crossing then 100
    else 0

assign accesspenalty
    switch motorroad=yes 10000 # I can't access motorroads
    switch highway=motorway|motorway_link|trunk|trunk_link|construction|proposed|abandoned 10000 # I can't access highways
    switch or access=private|no bicycle=private 10000 # I can't access private roads
    switch or bicycle=no ( and highway=footway and footway=sidewalk not bicycle=yes|designated ) 5 # I shoudn't ride on sidewalks
    0

assign badoneway =
       if reversedirection=yes then
         if oneway:bicycle=yes then true
         else if oneway= then junction=roundabout
         else oneway=yes|true|1
       else oneway=-1

assign onewaypenalty =
       if ( badoneway ) then
       (
         if      ( cycleway=opposite|opposite_lane|opposite_track       ) then 0
         else if ( cycleway:left=opposite|opposite_lane|opposite_track  ) then 0
         else if ( cycleway:right=opposite|opposite_lane|opposite_track ) then 0
         else if ( oneway:bicycle=no                         ) then 0
         else if ( cycleway:left:oneway=no                   ) then 0
         else if ( cycleway:right:oneway=no                  ) then 0
         else if ( junction=roundabout|circular              ) then 60
         else if ( highway=primary|primary_link|secondary|secondary_link              ) then 50
         else if ( highway=tertiary|tertiary_link            ) then 20
         else 6
       )
       else 0


assign isreversed = reversedirection=yes

assign town_penalty_factor 1

assign town_penalty
   switch estimated_town_class=   multiply 0 town_penalty_factor
   switch estimated_town_class=1  multiply 0.2 town_penalty_factor
   switch estimated_town_class=2  multiply 0.6 town_penalty_factor
   switch estimated_town_class=3  multiply 0.8 town_penalty_factor
   switch estimated_town_class=4  multiply 1 town_penalty_factor
   switch estimated_town_class=5  multiply 1.2 town_penalty_factor
   switch estimated_town_class=6  multiply 2 town_penalty_factor
   99


assign wayPenaltyCost
    switch    route=ferry                                                                             10000 # not passable
    switch    highway=steps                                                                           10000
    switch    highway=primary|primary_link                                                            primaryCost
    switch    highway=secondary|secondary_link|tertiary|tertiary_link|cycleway|rest_area|pedestrian|residential|living_street|service|residential|unclassified|bridleway|track|road|path|footway|raceway|corridor|platform|crossing   0
    10000 # I can't ride on not roads

# on these road I wont be able to ride fast
assign trafficPenaltyCost
  switch highway=pedestrian|footway     0.2
  0

assign hascycleway
    switch cycleway=                                                         false
    switch and not isreversed and not cycleway:right=no not cycleway:right=  true
    switch and isreversed and not cycleway:left=no not cycleway:left=        true
    switch cycleway=no                                                       false
    false

assign any_cycleroute  or route_bicycle_icn=yes or route_bicycle_ncn=yes or route_bicycle_rcn=yes or route_bicycle_lcn=yes route=bicycle

assign unsafePenaltyCost
  switch bicycle=designated                                 0
  switch motor_vehicle=no|private|agricultural              0
  switch hascycleway                                        0
  switch any_cycleroute                                     multiply 0.5 cyclingInfrastuctureFactor
  switch or hgv=no|destination maxspeed=30                  multiply 0.6 cyclingInfrastuctureFactor
                                                            multiply 1.3 cyclingInfrastuctureFactor
assign no_forest_penalty
     switch estimated_forest_class=   multiply 1 forestFactor
     switch estimated_forest_class=1  multiply 0.5 forestFactor
     switch estimated_forest_class=2  multiply 0.4 forestFactor
     switch estimated_forest_class=3  multiply 0.25 forestFactor
     switch estimated_forest_class=4  multiply 0.15 forestFactor
     switch estimated_forest_class=5  multiply 0.1 forestFactor
     switch estimated_forest_class=6  multiply 0  forestFactor
     99

assign costfactor
  add onewaypenalty
  add accesspenalty
  add town_penalty
  add surfaceCost
  add trafficPenaltyCost
  add wayPenaltyCost
  add unsafePenaltyCost
  add no_forest_penalty
  0

# faster road, bigger turn cost
assign turncost = if junction=roundabout then 0 else divide 130 costfactor

---context:node  # following code refers to node tags

assign applyDirection =
    switch and direction=backward way:isreversed 1
    switch and direction=backward not way:isreversed 0
    switch and direction=forward not way:isreversed 1
    switch and direction=forward way:isreversed 0
    0

assign applyTrafficDirection
    switch and traffic_signals:direction=backward way:isreversed 1
    switch and traffic_signals:direction=backward not way:isreversed 0
    switch and traffic_signals:direction=forward not way:isreversed 1
    switch and traffic_signals:direction=forward way:isreversed 0
    0

assign barrierPenalty
	switch barrier=block|bollard 25
	switch barrier=gate|swing_gate|lift_gate|entrance 50
	switch barrier=cycle_barrier 90
	switch and traffic_calming=bump applyDirection 25
	switch and traffic_calming=cushion applyDirection 10
		0

assign crossingsPenalty
	switch railway=level_crossing 300
	switch and highway=traffic_signals applyTrafficDirection 200
	switch and highway=crossing not crossing=unmarked 25
	switch and highway=give_way applyDirection 80
	switch and highway=stop applyDirection 120
		0

assign initialcost =
	add barrierPenalty
	add crossingsPenalty
    0

