#
# Originaly a fastbike profile
# Modified for gravel traveling - it prefers cycling infrastructure, roads without cars and cycling routes, but it is not a must. It prefers light terrain over asphalt.
#

---context:global   # following code refers to global config

# Bike profile
assign validForBikes = true

# Change elevation parameters
assign downhillcost       = 10     # %downhillcost% | Cena za jízdu z kopce | number
assign downhillcutoff     = 20     # %downhillcutoff% | Nižší sklon než tento se do jízdy z kopce nezapočítá. | number
assign uphillcost         = 10    # %uphillcost% | Cena za jízdu do kopce | number
assign uphillcutoff       = 5     # %uphillcutoff% | Nižší sklon než tento se do jízdy do kopce nezapočítá.  | number

assign primaryCost          = 1    # %primaryCost% | Cena za jízdu po silnici první třídy | number
assign pavedFactor          = 1.4    # %pavedFactor% | Ovlivní routování přes zpevněné cesty, 0.5 znamená o 50% nižší náklady po zpevněných cestách defaultu. | number
assign forestFactor         = 0.8    # %forestFactor% | Ovlivní routování přes lesy, 0.5 znamená o 50% nižší náklady mimo les oproti defaultu. 0 faktor lesů vypne | number
assign cyclingInfrastuctureFactor         = 0.7    # %cyclingInfrastuctureFactor% | Ovlivní routování přes cyklistickou infrastrukturu a trasy. 0.5 znamená o 50% nižší náklady trasám bez infrastruktury oproti defaultu. 0 faktor infrastruktury vypne a bude se soutředit na kvalitu cest | number

include base/global.speed.brf CR_SPEED=0.01

# Turn instructions settings
assign turnInstructionMode          = 1
assign turnInstructionCatchingRange = 40
assign turnInstructionRoundabouts   = true
assign considerTurnRestrictions     = true

assign processUnusedTags            = true

---context:way   # following code refers to way-tags

assign allow_steps false

include surfaces/way.surface.brf
include surfaces/way.surface.gravel.brf
include base/way.initialcost.brf
include base/way.accesspenalty.brf
include base/way.oneway.brf
include base/way.town.brf TOWN_FACTOR=1
include base/way.penalty.brf

# on these road I wont be able to ride fast
assign trafficPenaltyCost
  switch highway=pedestrian|footway     0.2
  0

assign hascycleway
    switch cycleway=                                                         false
    switch and not isreversed and not cycleway:right=no not cycleway:right=  true
    switch and isreversed and not cycleway:left=no not cycleway:left=        true
    switch cycleway=no                                                       false
    false

assign any_cycleroute  or route_bicycle_icn=yes or route_bicycle_ncn=yes or route_bicycle_rcn=yes or route_bicycle_lcn=yes route=bicycle

assign unsafePenaltyCost
  switch bicycle=designated                                 0
  switch motor_vehicle=no|private|agricultural              0
  switch hascycleway                                        0
  switch isUnpaved                                          0
  switch any_cycleroute                                     multiply 0.2 cyclingInfrastuctureFactor
  switch or hgv=no|destination maxspeed=30|50               multiply 0.6 cyclingInfrastuctureFactor
                                                            multiply 1.3 cyclingInfrastuctureFactor
assign noForestPenalty
     switch estimated_forest_class=   multiply 1 forestFactor
     switch estimated_forest_class=1  multiply 0.5 forestFactor
     switch estimated_forest_class=2  multiply 0.4 forestFactor
     switch estimated_forest_class=3  multiply 0.25 forestFactor
     switch estimated_forest_class=4  multiply 0.15 forestFactor
     switch estimated_forest_class=5  multiply 0.1 forestFactor
     switch estimated_forest_class=6  multiply 0  forestFactor
     99

assign costfactor
  add onewaypenalty
  add accesspenalty
  add town_penalty
  add surfaceCost
  add trafficPenaltyCost
  add wayPenaltyCost
  add unsafePenaltyCost
  add noForestPenalty
  0

# faster road, bigger turn cost
assign turncost = if junction=roundabout then 0 else divide 130 costfactor

---context:node  # following code refers to node tags

include base/node.brf traffic_lights_avoideness=200
